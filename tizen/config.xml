<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ultra TV pour Samsung TV (Tizen). Widget web standard : index.html + assets de web/dist,
  assemblés par scripts/build.mjs (web/build:tv). La version est réécrite depuis VERSION à racine.
  L'installation sur un vrai TV exige un .wgt signé (certificat auteur Samsung + certificat
  distributeur lié au DUID du TV) — voir README.md.
  Appareils : Tizen 5.5+ (TV Samsung 2020+) — Chromium 76, floor matériel de l'application web.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="com.ultratv.app" version="1.3.34" viewmodes="maximized">
  <tizen:application id="com.ultratv.app" package="com.ultratv" required_version="5.5"/>

  <content src="index.html"/>
  <icon src="icons/app_icon.png"/>
  <name>Ultra TV</name>
  <description>Lecteur IPTV gratuit et open source (Xtream Codes, M3U, Stalker), piloté à la télécommande. Ultra TV ne fournit aucun contenu.</description>
  <author href="https://github.com/vantaflow">vantaflow</author>
  <license href="https://opensource.org/licenses/MIT">MIT</license>

  <!-- Réseau : sources IPTV, guide et Worker sur n'importe quel hôte (sans ces deux lignes, toute
       requête est bloquée). Touches média et chaîne ± : livrées seulement après registerKey. -->
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

  <!-- Plein écran TV 16:9. -->
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv"/>

  <!-- Pas de tâche de fond : l'app vit au premier plan (lecture incluse), comme sur Android. -->
  <tizen:setting name="background-support" value="disable"/>
  <!-- Le code n'est pas chiffré : un .wgt en clair se débogue et se signe partout ; le chiffrement
       du widget exigerait un profil de sécurité spécifique à chaque TV. -->
  <tizen:setting name="encryption" value="disable"/>
</widget>
