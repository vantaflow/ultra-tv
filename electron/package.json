{
  "name": "ultratv-desktop",
  "version": "1.2.54",
  "description": "Ultra TV desktop - Electron shell around the web app.",
  "author": "Ultra TV",
  "license": "MIT",
  "homepage": "https://github.com/vantaflow/ultra-tv",
  "repository": {
    "type": "git",
    "url": "https://github.com/vantaflow/ultra-tv.git"
  },
  "main": "main.cjs",
  "scripts": {
    "test": "node --test \"test/*.test.cjs\"",
    "dev": "cross-env SV_DEV=1 electron .",
    "start": "electron .",
    "build:web": "cd ../web && npm run build",
    "prepare:web": "node scripts/prepare-web.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package:mac": "npm run prepare:web && electron-builder --mac dmg zip --universal --publish never",
    "package:win": "npm run prepare:web && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run prepare:web && electron-builder --linux AppImage deb rpm --x64 --publish never",
    "build:ffmpeg:win": "bash scripts/build-ffmpeg-min.sh win",
    "build:ffmpeg:linux": "bash scripts/build-ffmpeg-min.sh linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.ultratv.desktop",
    "productName": "Ultra TV",
    "copyright": "Ultra TV",
    "artifactName": "UltraTV-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "proxy.cjs",
      "appfiles.cjs",
      "secrets.cjs",
      "updates.cjs",
      "autoupdate.cjs",
      "cloudfetch.cjs",
      "dns.cjs",
      "transcode.cjs",
      "windowfit.cjs",
      "trailer.cjs",
      "recorder.cjs",
      "web-dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vantaflow",
        "repo": "ultra-tv",
        "releaseType": "draft"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Ultra TV ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "executableName": "ultratv",
      "maintainer": "Ultra TV <76207730+vantaflow@users.noreply.github.com>",
      "synopsis": "Lecteur IPTV",
      "desktop": {
        "entry": {
          "Name": "Ultra TV",
          "Comment": "Lecteur IPTV",
          "Categories": "AudioVideo;Video;Player;",
          "StartupWMClass": "Ultra TV"
        }
      },
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0 | libgtk-3-0t64",
        "libasound2 | libasound2t64",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "rpm": {
      "depends": [
        "nss",
        "gtk3",
        "alsa-lib",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils"
      ]
    },
    "afterSign": "scripts/adhoc-sign.cjs"
  }
}
